# Application
NODE_ENV=development
PORT=3000
WEB_PORT=8080

# PostgreSQL (Docker Compose defaults — development only, not for production)
POSTGRES_USER=are
POSTGRES_PASSWORD=are_dev_password
POSTGRES_DB=architecture_reasoning
POSTGRES_PORT=5432
DATABASE_URL=postgresql://are:are_dev_password@localhost:5432/architecture_reasoning

# Inside Compose, the API uses the service hostname `postgres`:
# DATABASE_URL=postgresql://are:are_dev_password@postgres:5432/architecture_reasoning

# ---------------------------------------------------------------------------
# LLM (Phase 5)
# Primary provider for this project: OpenAI (Responses API + Structured Outputs)
# Default offline/CI provider: fake (no network, no charges)
# ---------------------------------------------------------------------------
LLM_PROVIDER=fake
# LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=60000

# Optional input limits
# LLM_MAX_ARCHITECTURE_CHARS=20000
# LLM_MAX_QUESTION_CHARS=4000

# Live evaluation opt-in (never set in CI):
# RUN_LIVE_OPENAI=1

# Evaluation Lab HTTP endpoints (Phase 9) — disabled by default.
# Backend enforces the gate (403) even if the SPA still shows Evaluation Lab nav.
# Demo Compose override: docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d --build
# EVAL_LAB_ENABLED=0
# EVAL_LAB_ENABLED=1
