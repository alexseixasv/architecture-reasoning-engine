# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (Docker Compose defaults — development only, not for production)
POSTGRES_USER=are
POSTGRES_PASSWORD=are_dev_password
POSTGRES_DB=architecture_reasoning
POSTGRES_PORT=5432
DATABASE_URL=postgresql://are:are_dev_password@localhost:5432/architecture_reasoning

# Inside Compose, the API uses the service hostname `postgres`:
# DATABASE_URL=postgresql://are:are_dev_password@postgres:5432/architecture_reasoning

# LLM provider (Phase 5 — unused in Phase 1)
# Preferred zero-cost local option: Ollama-compatible endpoint.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# OpenAI-compatible alternative (optional):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Bootstrap note: if using Ollama, you must pull model weights separately
# (e.g. `ollama pull llama3.2`). Phase 1 does not start Ollama in Compose.
