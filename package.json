{
  "name": "architecture-reasoning-engine",
  "version": "0.1.0",
  "description": "Deterministic architecture analysis engine with AI-assisted extraction",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit tests/golden tests/adversarial tests/validation",
    "test:unit": "vitest run tests/unit",
    "test:golden": "vitest run tests/golden",
    "test:adversarial": "vitest run tests/adversarial",
    "test:validation": "vitest run tests/validation",
    "test:integration": "vitest run tests/integration",
    "test:http": "vitest run tests/integration/http",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "llm:live-eval": "tsx scripts/live-validation-eval.ts",
    "llm:live-smoke": "tsx scripts/live-smoke.ts",
    "compose:frontend-acceptance": "tsx scripts/compose-frontend-acceptance.ts",
    "compose:http-acceptance": "tsx scripts/compose-http-acceptance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.57.0",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
